# cpf_validator.py
import re

def normalize_cpf(cpf: str) -> str:
    """Remove tudo que não for número (pontuação, espaços)."""
    return re.sub(r'\D', '', cpf or '')

def is_repeated_sequence(digits: str) -> bool:
    """Verifica se todos os dígitos são iguais (ex: 11111111111)."""
    return len(set(digits)) == 1

def calc_check_digit(digits: str, factor_start: int) -> int:
    """Calcula um dígito verificador do CPF."""
    total = 0
    factor = factor_start
    for ch in digits:
        total += int(ch) * factor
        factor -= 1
    resto = total % 11
    return 0 if resto < 2 else 11 - resto

def validate_cpf(cpf: str) -> (bool, str):
    """
    Retorna (True, None) se válido,
    ou (False, motivo) se inválido.
    """
    n = normalize_cpf(cpf)
    if len(n) != 11:
        return False, "CPF deve ter 11 dígitos"
    if not n.isdigit():
        return False, "CPF contém caracteres inválidos"
    if is_repeated_sequence(n):
        return False, "CPF inválido (sequência repetida)"
    # Calcula os dígitos verificadores
    first9 = n[:9]
    d1 = calc_check_digit(first9, 10)
    d2 = calc_check_digit(first9 + str(d1), 11)
    if n[-2:] != f"{d1}{d2}":
        return False, "Dígitos verificadores não conferem"
    return True, None

def main():
    print("Validador de CPF simples")
    while True:
        cpf = input("Digite um CPF (ou 'sair' para terminar): ").strip()
        if cpf.lower() in ('sair', 'exit', 'q'):
            print("Encerrando. Até mais!")
            break
        valid, reason = validate_cpf(cpf)
        normalized = re.sub(r'\D', '', cpf)
        if valid:
            print(f"CPF VÁLIDO — forma normalizada: {normalized}")
        else:
            print(f"CPF INVÁLIDO — motivo: {reason}")
        print("-" * 40)

if __name__ == "__main__":
    main()
